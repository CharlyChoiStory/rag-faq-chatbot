OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.2
OPENAI_REWRITE_MODEL=gpt-4o-mini

SUPABASE_URL=replace_with_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Retrieval tuning for company rules RAG.
RAG_MATCH_THRESHOLD=0.45
RAG_MATCH_COUNT=5

# Notion company rules source.
# Use NOTION_RULES_API_KEY when the rules page belongs to a different Notion
# account/workspace than the old project source.
NOTION_RULES_API_KEY=replace_with_hsikchoi_notion_integration_secret
NOTION_RULES_PAGE_ID=35e0d17ecf4a801d8166eff8982245a9
NOTION_RULES_PAGE_URL=https://www.notion.so/charly-choi/35e0d17ecf4a801d8166eff8982245a9?pvs=12

# Legacy fallback for older scripts.
NOTION_API_KEY=replace_with_notion_api_key
NOTION_ROOT_PAGE_ID=35e0d17ecf4a801d8166eff8982245a9
NOTION_ROOT_PAGE_URL=https://www.notion.so/charly-choi/35e0d17ecf4a801d8166eff8982245a9?pvs=12
